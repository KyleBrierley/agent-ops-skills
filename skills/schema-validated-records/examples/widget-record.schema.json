{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "tool",
    "status",
    "confidence",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "current",
        "previous",
        "evaluating"
      ]
    },
    "confidence": {
      "enum": [
        "confirmed",
        "inferred",
        "reported"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url",
          "support"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "support": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
